# Optional overrides. The default stack needs no .env file and no API keys.
# Copy to .env only if you want to change something. .env is ignored by Git.
POSTGRES_PASSWORD=local-only-demo
RETENTION_DAYS=30
# fixture (default, deterministic) or ollama (optional local inference)
LAB_MODEL_ADAPTER=fixture
OLLAMA_URL=http://ollama:11434
# Example tags; record the exact tags and hardware used in docs/EVALUATION.md.
OLLAMA_MODEL_LIGHT=
OLLAMA_MODEL_HEAVY=
